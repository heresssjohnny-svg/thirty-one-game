# Copy to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=production

# Session token signing secret (long random string)
JWT_SECRET=

# LiveKit SFU
LIVEKIT_HOST=wss://31game.duckdns.org
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Password-recovery email sender (Gmail app password, spaces optional)
SMTP_EMAIL=
SMTP_PASSWORD=

# Admin portal (admin.html)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Idle lobby cleanup in ms (default 5 minutes)
INACTIVITY_TIMEOUT_MS=300000

# Shuffle & deal window at the start of every hand, in ms (no turn actions,
# bot moves or turn timer until it ends; the client animation fits inside it)
DEAL_ANIMATION_MS=16000
